{
  "installCommand": "npm install --prefix Carbon-backend && npm install --prefix Carbon-frontend",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "Carbon-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
